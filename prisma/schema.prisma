generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ========== MODELOS DE AUTENTICACIÓN ==========

enum Role {
  user
  admin
}

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  password      String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(admin)
  phone         String?
  status        String?   @default("active")
  accounts      Account[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?  @db.Text
  access_token             String?  @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?  @db.Text
  session_state            String?
  refresh_token_expires_in Int?
  user                     User?    @relation(fields: [userId], references: [id])
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@unique([identifier])
}

// ========== MODELOS DEL SISTEMA INMOBILIARIO ==========

model TipoCliente {
  id_tipo_cliente Int       @id @default(autoincrement())
  nombre          String    @db.VarChar(50) // Ej: Propietario, Comprador, Arrendatario
  clientes        Cliente[]
}

model Cliente {
  id_cliente    Int          @id @default(autoincrement())
  nombre        String       @db.VarChar(100)
  email         String?      @db.VarChar(100)
  telefono      String?      @db.VarChar(50)
  tipoClienteId Int?
  tipoCliente   TipoCliente? @relation(fields: [tipoClienteId], references: [id_tipo_cliente])
  inmuebles     Inmueble[]
  contratos     Contrato[]
  cobranzas     Cobranza[]
  pagos         Pago[]
  historial     Historial[]  @relation("HistorialCliente")
}

model Tipo_inmueble {
  id_tipo_inmueble Int        @id @default(autoincrement())
  nombre           String     @db.VarChar(100)
  inmuebles        Inmueble[]
}

model Localidad {
  id_localidad Int      @id @default(autoincrement())
  nombre       String   @db.VarChar(100)
  barrios      Barrio[]
}

model Barrio {
  id_barrio    Int         @id @default(autoincrement())
  nombre       String      @db.VarChar(100)
  id_localidad Int
  localidad    Localidad   @relation(fields: [id_localidad], references: [id_localidad], onDelete: Restrict, onUpdate: Cascade)
  ubicaciones  Ubicacion[]
}

model Ubicacion {
  id_ubicacion Int        @id @default(autoincrement())
  direccion    String     @db.VarChar(200)
  ciudad       String?    @db.VarChar(100)
  provincia    String?    @db.VarChar(100)
  id_barrio    Int?
  barrio       Barrio?    @relation(fields: [id_barrio], references: [id_barrio], onDelete: Restrict, onUpdate: Cascade)
  inmuebles    Inmueble[]
}

model Estado {
  id_estado Int        @id @default(autoincrement())
  nombre    String     @db.VarChar(100)
  inmuebles Inmueble[]
}

model Operacion {
  id_operacion Int        @id @default(autoincrement())
  nombre       String     @db.VarChar(50)
  inmuebles    Inmueble[]
}

model Inmueble {
  id_inmueble          Int              @id @default(autoincrement())
  id_tipo_inmueble     Int
  tipo_inmueble        Tipo_inmueble    @relation(fields: [id_tipo_inmueble], references: [id_tipo_inmueble], onDelete: Restrict, onUpdate: Cascade)
  id_ubicacion         Int
  ubicacion            Ubicacion        @relation(fields: [id_ubicacion], references: [id_ubicacion], onDelete: Restrict, onUpdate: Cascade)
  id_estado            Int
  estado               Estado           @relation(fields: [id_estado], references: [id_estado], onDelete: Restrict, onUpdate: Cascade)
  id_operacion         Int?
  operacion            Operacion?       @relation(fields: [id_operacion], references: [id_operacion], onDelete: Restrict, onUpdate: Cascade)
  id_cliente           Int
  cliente              Cliente          @relation(fields: [id_cliente], references: [id_cliente], onDelete: Restrict, onUpdate: Cascade)
  titulo               String           @db.VarChar(200)
  superficie_total     Decimal          @db.Decimal(10, 2)
  superficie_cubierta  Decimal?         @db.Decimal(10, 2)
  cantidad_ambientes   Int?
  cantidad_banos       Int?
  cantidad_dormitorios Int?
  cantidad_cocheras    Int?
  cantidad_pisos       Int?
  antiguedad           Int?
  precio               Decimal?         @db.Decimal(10, 2)
  foto                 String?          @db.VarChar(200)
  detalles             String?          @db.VarChar(255)
  archivado            Boolean          @default(false)
  contratos            Contrato[]
  cobranzas            Cobranza[]
  rendiciones          Rendicion[]
  pagos                Pago[]
  historial            Historial[]      @relation("HistorialInmueble")
  imagenes             InmuebleImagen[]
}

model InmuebleImagen {
  id         Int      @id @default(autoincrement())
  url        String   @db.VarChar(255)
  principal  Boolean  @default(false)
  inmueble   Inmueble @relation(fields: [inmuebleId], references: [id_inmueble], onDelete: Cascade)
  inmuebleId Int

  @@index([inmuebleId], name: "idx_inmueble_imagen_inmuebleId")
}

model Template {
  id              Int        @id @default(autoincrement())
  nombre          String     @db.VarChar(100) // Nombre del template, ej: "Contrato Alquiler"
  archivoPath     String     @db.VarChar(255) // Ruta donde se guarda el .docx
  camposVariables Json?      // Lista de campos variables
  createdAt       DateTime   @default(now())
  contratos       Contrato[]
}

model Contrato {
  id_contrato  Int       @id @default(autoincrement())
  id_inmueble  Int
  inmueble     Inmueble  @relation(fields: [id_inmueble], references: [id_inmueble], onDelete: Restrict, onUpdate: Cascade)
  id_cliente   Int
  cliente      Cliente   @relation(fields: [id_cliente], references: [id_cliente], onDelete: Restrict, onUpdate: Cascade)
  id_template  Int?
  template     Template? @relation(fields: [id_template], references: [id], onDelete: SetNull, onUpdate: Cascade)
  nombre       String?   @db.VarChar(100) // Nombre del contrato
  valores      Json?     // Valores de los campos variables
  archivoPath  String?   @db.VarChar(255) // Ruta del contrato generado
  fecha_inicio DateTime
  fecha_fin    DateTime
  monto        Decimal   @db.Decimal(10, 2)
  createdAt    DateTime  @default(now())
}

model Cobranza {
  id_cobranza Int      @id @default(autoincrement())
  id_inmueble Int
  inmueble    Inmueble @relation(fields: [id_inmueble], references: [id_inmueble], onDelete: Restrict, onUpdate: Cascade)
  id_cliente  Int
  cliente     Cliente  @relation(fields: [id_cliente], references: [id_cliente], onDelete: Restrict, onUpdate: Cascade)
  monto       Decimal  @db.Decimal(10, 2)
  fecha       DateTime
}

model Rendicion {
  id_rendicion Int      @id @default(autoincrement())
  id_inmueble  Int
  inmueble     Inmueble @relation(fields: [id_inmueble], references: [id_inmueble], onDelete: Restrict, onUpdate: Cascade)
  fecha        DateTime
  monto_total  Decimal  @db.Decimal(10, 2)
}

model Pago {
  id_pago     Int      @id @default(autoincrement())
  id_inmueble Int
  inmueble    Inmueble @relation(fields: [id_inmueble], references: [id_inmueble], onDelete: Restrict, onUpdate: Cascade)
  id_cliente  Int
  cliente     Cliente  @relation(fields: [id_cliente], references: [id_cliente], onDelete: Restrict, onUpdate: Cascade)
  monto       Decimal  @db.Decimal(10, 2)
  fecha       DateTime
}

model Historial {
  id_historial Int       @id @default(autoincrement())
  descripcion  String    @db.VarChar(255)
  fecha        DateTime
  id_inmueble  Int?
  inmueble     Inmueble? @relation("HistorialInmueble", fields: [id_inmueble], references: [id_inmueble], onDelete: SetNull, onUpdate: Cascade)
  id_cliente   Int?
  cliente      Cliente?  @relation("HistorialCliente", fields: [id_cliente], references: [id_cliente], onDelete: SetNull, onUpdate: Cascade)
}

// ========== MODELO TIPO DE SERVICIO ==========

model TipoServicio {
  id_tipo_servicio Int         @id @default(autoincrement())
  nombre           String      @db.VarChar(100) @unique
  proveedores      Proveedor[]
}


// ========== MODELO PROVEEDOR ==========

model Proveedor {
  id_proveedor        Int           @id @default(autoincrement())
  nombre_razon_social String        @db.VarChar(150)
  cuit_cuil           String        @db.VarChar(20) @unique
  correo_contacto     String?       @db.VarChar(100)
  telefono_contacto   String?       @db.VarChar(50)
  direccion           String?       @db.VarChar(200)

  // Relación con TipoServicio
  tipoServicioId      Int
  tipoServicio        TipoServicio  @relation(fields: [tipoServicioId], references: [id_tipo_servicio], onDelete: Restrict, onUpdate: Cascade)

  datos_bancarios     String?       @db.Text
  estado              Boolean       @default(true)  // ← CAMBIO IMPORTANTE
  observaciones       String?       @db.VarChar(255)
  fecha_alta          DateTime      @default(now())

  pagos               PagoProveedor[]
}

// ===============================
// MODELO ESTADO DE PAGO
// ===============================
model EstadoPago {
  id_estado_pago  Int              @id @default(autoincrement())
  nombre          String           @unique @db.VarChar(100)
  pagos           PagoProveedor[]
}

// ===============================
// MODELO MEDIO DE PAGO
// ===============================
model MedioPago {
  id_medio_pago  Int              @id @default(autoincrement())
  nombre         String           @unique @db.VarChar(100)
  pagos          PagoProveedor[]
}

// ===============================
// MODELO PAGO A PROVEEDOR
// ===============================
model PagoProveedor {
  id_pago              Int            @id @default(autoincrement())
  fecha_pago           DateTime
  proveedorId          Int
  proveedor            Proveedor       @relation(fields: [proveedorId], references: [id_proveedor], onDelete: Restrict)
  concepto             String          @db.VarChar(255)
  importe              Decimal         @db.Decimal(10,2)

  // Medio de pago (relación)
  medioPagoId          Int
  medioPago            MedioPago       @relation(fields: [medioPagoId], references: [id_medio_pago], onDelete: Restrict)

  comprobante          String?         @db.VarChar(255)
  responsable          String          @db.VarChar(150)

  // Estado del pago (relación)
  estadoPagoId         Int
  estadoPago           EstadoPago      @relation(fields: [estadoPagoId], references: [id_estado_pago], onDelete: Restrict)

  fecha                DateTime        @default(now())
  fecha_modificacion   DateTime        @updatedAt
}
